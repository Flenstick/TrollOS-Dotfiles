// angelOS {{flavor}} / {{mode}} — generated by angelOS, do not edit (templates/niri-material.kdl: Material You)
layout {
    focus-ring {
        active-color   "{{accent}}"
        inactive-color "{{lo}}"
        urgent-color   "{{danger}}"
    }
    border {
        active-color   "{{accent}}"
        inactive-color "{{lo}}"
        urgent-color   "{{danger}}"
    }
    tab-indicator {
        active-color   "{{accent}}"
        inactive-color "{{accent4}}"
        urgent-color   "{{danger}}"
    }
    insert-hint {
        color "{{accent}}80"
    }
}

recent-windows {
    highlight {
        active-color "{{accent}}"
        urgent-color "{{danger}}"
    }
}

// TrollOS Material You: every window rounded by 16 px, like Material 3's large shape (GTK draws
// the same: templates/gtk4-material.css). angelOS's own windows round themselves.
window-rule {
    exclude app-id="^org.quickshell$" title="^angelOS"
    exclude app-id="^liquid-glass-test$"
    exclude app-id=r#"(?i)photoshop"#
    exclude title=r#"^Adobe Photoshop"#
    geometry-corner-radius 16
    clip-to-geometry true
}

// TrollOS Material You: windows open the Material 3 way — a container transform: the window
// grows out of a point a little below its middle (a round reveal, scaled up from 88 %, fading in)
// on the emphasized-decelerate curve; it closes quicker, shrinking and fading (emphasized
// accelerate). Every window, the terminal too.
animations {
    window-open {
        duration-ms 460
        curve "cubic-bezier" 0.05 0.7 0.1 1
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = mix(0.88, 1.0, p);
                vec2 c = vec2(0.5, 0.6);
                vec2 uv = (coords_geo.xy - c) / scale + c;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
                    return vec4(0.0);
                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);
                vec2 px = (uv - c) * size_geo.xy;
                float r = length(size_geo.xy) * 0.62 * smoothstep(0.0, 0.8, p) + 1.0;
                float mask = 1.0 - smoothstep(r - 28.0, r, length(px));
                float alpha = smoothstep(0.0, 0.3, p);
                return color * mask * alpha;
            }
        "
    }
    window-close {
        duration-ms 200
        curve "cubic-bezier" 0.3 0 0.8 0.15
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = mix(1.0, 0.9, p);
                vec2 c = vec2(0.5, 0.6);
                vec2 uv = (coords_geo.xy - c) / scale + c;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
                    return vec4(0.0);
                vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);
                return color * (1.0 - p);
            }
        "
    }
}
