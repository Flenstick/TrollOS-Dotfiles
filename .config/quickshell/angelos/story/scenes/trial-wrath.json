{
  "id": "trial-wrath",
  "title": {
    "ru": "Испытание: Гнев",
    "en": "Trial: Wrath"
  },
  "draft": true,
  "with": "demon",
  "start": "in",
  "nodes": {
    "in": {
      "type": "event",
      "trigger": "trial",
      "cond": "circle == \"wrath\"",
      "next": "pactCheck",
      "note": "a try to get out of this circle (Ask → Seek the way out, the wheel's plea)"
    },
    "pactCheck": {
      "type": "if",
      "cond": "attempts >= pactAfter and not pact",
      "then": "toPact",
      "else": "ask"
    },
    "toPact": {
      "type": "scene",
      "to": "pact"
    },
    "ask": {
      "type": "choice",
      "who": "demon",
      "sprite": "neutral",
      "text": {
        "ru": "Из воды кто-то держит тебя за ногу. Ударишь — отпустит. Наверное.",
        "en": "Someone under the water holds your foot. Strike — it'll let go. Probably."
      },
      "choices": [
        {
          "text": {
            "ru": "Не бить",
            "en": "Don't strike"
          },
          "tone": "positive",
          "reply": {
            "who": "demon",
            "sprite": "neutral",
            "text": {
              "ru": "Рука разжалась сама. Иди дальше, вниз.",
              "en": "The hand let go by itself. Go on, down."
            }
          },
          "next": "down"
        },
        {
          "text": {
            "ru": "Ударить",
            "en": "Strike"
          },
          "tone": "negative",
          "set": {
            "wrath": "+1"
          },
          "reply": {
            "who": "demon",
            "sprite": "neutral",
            "text": {
              "ru": "Ударил{g:|а|(а)}. Вода стала гуще.",
              "en": "You struck. The water grew thicker."
            }
          },
          "next": "stay"
        },
        {
          "text": {
            "ru": "Промолчать",
            "en": "Say nothing"
          },
          "tone": "silent",
          "reply": {
            "who": "demon",
            "sprite": "neutral",
            "text": {
              "ru": "Вода сомкнулась. Ты стоишь на месте.",
              "en": "The water closed. You stand where you were."
            }
          },
          "next": "stay"
        }
      ],
      "shuffle": true
    },
    "stay": {
      "type": "circle",
      "to": "stay"
    },
    "down": {
      "type": "circle",
      "to": "deeper"
    }
  }
}
