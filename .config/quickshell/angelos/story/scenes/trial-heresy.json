{
  "id": "trial-heresy",
  "title": {
    "ru": "Испытание: Ересь",
    "en": "Trial: Heresy"
  },
  "draft": true,
  "with": "demon",
  "start": "in",
  "nodes": {
    "in": {
      "type": "event",
      "trigger": "trial",
      "cond": "circle == \"heresy\"",
      "next": "pactCheck",
      "note": "a try to get out of this circle (Ask → Seek the way out, the wheel's plea)"
    },
    "pactCheck": {
      "type": "if",
      "cond": "attempts >= pactAfter and not pact",
      "then": "toPact",
      "else": "ask"
    },
    "toPact": {
      "type": "scene",
      "to": "pact"
    },
    "ask": {
      "type": "choice",
      "who": "demon",
      "sprite": "neutral",
      "text": {
        "ru": "Скажи, что ангела не было. Скажи — и стены Дита откроются.",
        "en": "Say there never was an angel. Say it — and the walls of Dis will open."
      },
      "choices": [
        {
          "text": {
            "ru": "Она была",
            "en": "She was real"
          },
          "tone": "positive",
          "reply": {
            "who": "demon",
            "sprite": "neutral",
            "text": {
              "ru": "Упрям{g:ый|ая|ый(ая)}. Стены открылись всё равно. Ниже.",
              "en": "Stubborn. The walls opened anyway. Further down."
            }
          },
          "next": "down"
        },
        {
          "text": {
            "ru": "Её не было",
            "en": "There was none"
          },
          "tone": "negative",
          "set": {
            "heresy": "+1"
          },
          "reply": {
            "who": "demon",
            "sprite": "neutral",
            "text": {
              "ru": "Вот и ложись в свою гробницу. Она тёплая.",
              "en": "Then lie down in your tomb. It's warm."
            }
          },
          "next": "stay"
        },
        {
          "text": {
            "ru": "Промолчать",
            "en": "Say nothing"
          },
          "tone": "silent",
          "reply": {
            "who": "demon",
            "sprite": "neutral",
            "text": {
              "ru": "Гробницы ждут ответа. Они умеют ждать.",
              "en": "The tombs await an answer. They know how to wait."
            }
          },
          "next": "stay"
        }
      ],
      "shuffle": true
    },
    "stay": {
      "type": "circle",
      "to": "stay"
    },
    "down": {
      "type": "circle",
      "to": "deeper"
    }
  }
}
