{
  "id": "close-limbo-1",
  "title": {
    "ru": "Лимб: знакомая",
    "en": "Limbo: acquainted"
  },
  "draft": true,
  "with": "demon",
  "start": "in",
  "nodes": {
    "in": {
      "type": "event",
      "trigger": "close",
      "cond": "circle == \"limbo\" and closeness == 1",
      "next": "ask",
      "note": "the demon of limbo and the player: closeness acquainted (story/game.json → closeness)"
    },
    "ask": {
      "type": "choice",
      "who": "demon",
      "sprite": "neutral",
      "text": {
        "ru": "Я завела на вас отдельную папку. Можно вопрос не по форме: вам здесь не скучно?",
        "en": "I've opened a separate file on you. May I ask off the record: aren't you bored here?"
      },
      "choices": [
        {
          "text": {
            "ru": "С тобой — нет",
            "en": "Not with you"
          },
          "tone": "positive",
          "reply": {
            "who": "demon",
            "sprite": "neutral",
            "text": {
              "ru": "Отмечено. Двойной галочкой.",
              "en": "Noted. With a double tick."
            }
          },
          "next": "end"
        },
        {
          "text": {
            "ru": "Скучно",
            "en": "I am"
          },
          "tone": "negative",
          "reply": {
            "who": "demon",
            "sprite": "neutral",
            "text": {
              "ru": "Это лимб. Здесь иначе нельзя.",
              "en": "This is limbo. It can't be otherwise here."
            }
          },
          "next": "end",
          "set": {
            "limbo": "+1"
          }
        },
        {
          "text": {
            "ru": "Промолчать",
            "en": "Say nothing"
          },
          "tone": "silent",
          "reply": {
            "who": "demon",
            "sprite": "neutral",
            "text": {
              "ru": "Молчание тоже ответ. Записала.",
              "en": "Silence is an answer too. Noted."
            }
          },
          "next": "end"
        }
      ]
    },
    "end": {
      "type": "end"
    }
  }
}
