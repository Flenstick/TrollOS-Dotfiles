binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── angelOS keybinds (were noctalia) ───
    // https://docs.noctalia.dev/getting-started/keybinds/

    Mod+Shift+ESCAPE                     { show-hotkey-overlay; }

    // ─── Applications ───
    Mod+T                          hotkey-overlay-title="Open Terminal: kitty" { spawn "kitty"; }
    Mod+Return                     hotkey-overlay-title="Open Terminal: kitty" { spawn "kitty"; }
    Mod+B                               hotkey-overlay-title="Open Browser: default" { spawn-sh "xdg-open about:blank"; }

    // --- Noctalia ---
    Mod+Shift+Return                    hotkey-overlay-title="angelOS: обои" { spawn-sh "qs -c angelos ipc call angelos settings wallpaper"; }
    Mod+S                               hotkey-overlay-title="angelOS: настройки" { spawn-sh "qs -c angelos ipc call angelos settings appearance"; }
    Mod+Alt+S                           hotkey-overlay-title="angelOS: настройки" { spawn-sh "qs -c angelos ipc call angelos settings appearance"; }
    Mod+Space                    hotkey-overlay-title="angelOS: программы" { spawn-sh "qs -c angelos ipc call angelos launcher"; }
    Mod+ALT+L                           hotkey-overlay-title="angelOS: блокировка" { spawn-sh "qs -c angelos ipc call angelos lock"; }
    Mod+Shift+Q                         hotkey-overlay-title="angelOS: выключение" { spawn-sh "qs -c angelos ipc call angelos session"; }

    // Please set the text editor of your choice.
    // Mod+Shift+E                               hotkey-overlay-title="Open Text Editor: Zed" { spawn "zed"; }

    // Please choose your own file manager.
    Mod+E                               hotkey-overlay-title="File Manager: Nautilus" { spawn "nautilus"; }


    // ─── Media Controls ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "qs -c angelos ipc call angelos volumeUp"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "qs -c angelos ipc call angelos volumeDown"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "qs -c angelos ipc call angelos mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "qs -c angelos ipc call angelos micMute"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "qs -c angelos ipc call angelos media next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "qs -c angelos ipc call angelos media previous"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "qs -c angelos ipc call angelos media toggle"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "qs -c angelos ipc call angelos media pause"; }
    XF86AudioStop                       allow-when-locked=true { spawn-sh "qs -c angelos ipc call angelos media pause"; }

    // ─── Brightness Controls ───
    // XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    // XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // ─── Window Movement and Focus ───
    Mod+Q                               hotkey-overlay-title="Закрыть окно (claude/codex — с вопросом)" { spawn-sh "qs -c angelos ipc call closeconfirm ask"; }
    Mod+Ctrl+Q                          hotkey-overlay-title="Закрыть окно сразу" { close-window; }

    Mod+Left                            { focus-column-left; }
    Mod+H                               { focus-column-left; }
    Mod+Right                           { focus-column-right; }
    Mod+L                               { focus-column-right; }
    Mod+Up                              { focus-window-up; }
    Mod+K                               { focus-window-up; }
    Mod+Down                            { focus-window-down; }
    Mod+J                               { focus-window-down; }

    Mod+CTRL+Left                       { move-column-left; }
    Mod+CTRL+H                          { move-column-left; }
    Mod+CTRL+Right                      { move-column-right; }
    Mod+CTRL+L                          { move-column-right; }
    Mod+CTRL+UP                         { move-window-up; }
    Mod+CTRL+K                          { move-window-up; }
    Mod+CTRL+Down                       { move-window-down; }
    Mod+CTRL+J                          { move-window-down; }

    Mod+Home                            { focus-column-first; }
    Mod+End                             { focus-column-last; }
    Mod+CTRL+Home                       { move-column-to-first; }
    Mod+CTRL+End                        { move-column-to-last; }

    Mod+Shift+Left                      { focus-monitor-left; }
    Mod+Shift+Right                     { focus-monitor-right; }
    Mod+Shift+UP                        { focus-monitor-up; }
    Mod+Shift+Down                      { focus-monitor-down; }

    Mod+Shift+CTRL+Left                 { move-column-to-monitor-left; }
    Mod+Shift+CTRL+Right                { move-column-to-monitor-right; }
    Mod+Shift+CTRL+UP                   { move-column-to-monitor-up; }
    Mod+Shift+CTRL+Down                 { move-column-to-monitor-down; }
    Mod+Alt+V                           { switch-focus-between-floating-and-tiling; }

    Mod+BracketLeft                     { consume-or-expel-window-left; }
    Mod+BracketRight                    { consume-or-expel-window-right; }

    Mod+Comma                           { consume-window-into-column; }
    Mod+Shift+Period                    { expel-window-from-column; }
    Mod+Period                          hotkey-overlay-title="TrollOS: эмодзи и символы" { spawn-sh "qs -c angelos ipc call emoji toggle"; }

    Mod+R                               { switch-preset-column-width; }
    Mod+Alt+R                           { switch-preset-column-width-back; }
    Mod+Shift+R                         repeat=false hotkey-overlay-title="Record region → Videos (toggle)" { spawn "@HOME@/.local/bin/niri-record-region"; }
    Mod+G                               repeat=false hotkey-overlay-title="TrollOS: оверлей (заметки, гифки, видео)" { spawn-sh "qs -c angelos ipc call angelos overlay"; }

    Mod+Ctrl+Shift+R                    { switch-preset-window-height; }
    Mod+Ctrl+R                          { reset-window-height; }


    // ─── Workspace Switching ───
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Mod+CTRL+WheelScrollDown            cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp              cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
    Mod+CTRL+WheelScrollRight           { move-column-right; }
    Mod+CTRL+WheelScrollLeft            { move-column-left; }

    Mod+Shift+WheelScrollDown           { focus-column-right; }
    Mod+Shift+WheelScrollUp             { focus-column-left; }
    Mod+CTRL+Shift+WheelScrollDown      { move-column-right; }
    Mod+CTRL+Shift+WheelScrollUp        { move-column-left; }

    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }
    Mod+5                               { focus-workspace 5; }
    Mod+6                               { focus-workspace 6; }
    Mod+7                               { focus-workspace 7; }
    Mod+8                               { focus-workspace 8; }
    Mod+9                               { focus-workspace 9; }

    Mod+CTRL+1                          { move-column-to-workspace 1; }
    Mod+CTRL+2                          { move-column-to-workspace 2; }
    Mod+CTRL+3                          { move-column-to-workspace 3; }
    Mod+CTRL+4                          { move-column-to-workspace 4; }
    Mod+CTRL+5                          { move-column-to-workspace 5; }
    Mod+CTRL+6                          { move-column-to-workspace 6; }
    Mod+CTRL+7                          { move-column-to-workspace 7; }
    Mod+CTRL+8                          { move-column-to-workspace 8; }
    Mod+CTRL+9                          { move-column-to-workspace 9; }

    Mod+TAB                             repeat=false hotkey-overlay-title="Overview" { toggle-overview; }

    // ─── Layout Controls ───
    Mod+CTRL+F                          { expand-column-to-available-width; }
    Mod+C                               { center-column; }
    Mod+CTRL+C                          { center-visible-columns; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }


    // ─── Modes ───
    Mod+V                               hotkey-overlay-title="angelOS: буфер обмена" { spawn-sh "qs -c angelos ipc call angelos clipboard"; }
    Mod+Shift+Space                     hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    Mod+F                               { fullscreen-window; }
    Mod+Shift+F                         { maximize-column; }
    Mod+W                               { toggle-column-tabbed-display; }
    Mod+M                               { maximize-window-to-edges; }

    // ─── Screenshots (Win+Shift+S style) ───
    Mod+Shift+S                         repeat=false hotkey-overlay-title="Скриншот как в ShareX (экран замирает)" { spawn "@HOME@/.local/bin/angelos-shot"; }
    Print                               repeat=false hotkey-overlay-title="Скриншот как в ShareX" { spawn "@HOME@/.local/bin/angelos-shot"; }
    Mod+Shift+T                         hotkey-overlay-title="OCR: region to clipboard" { spawn "@HOME@/.local/bin/niri-ocr"; }
    Mod+Shift+V                         repeat=false hotkey-overlay-title="Voice: toggle dictation" { spawn "@HOME@/.local/bin/voxtype" "record" "toggle"; }
    CTRL+Shift+2                        { screenshot-screen; }
    CTRL+Shift+3                        { screenshot-window; }

    // ─── Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    CTRL+ALT+Delete                     { quit; } // Also quits Niri
    Mod+Shift+P                         { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
    Mod+Shift+X                         repeat=false allow-inhibiting=false hotkey-overlay-title="Privacy: block Telegram Bitwarden Helium Discord" { spawn "@HOME@/.local/bin/niri-cast-privacy"; }
    Mod+Alt+C                           hotkey-overlay-title="Кофеин: не спать вкл/выкл" { spawn-sh "qs -c angelos ipc call caffeine toggle"; }
    Mod+O                               hotkey-overlay-title="Previous workspace" { focus-workspace-previous; }

    // ─── angelOS extras ───
    Mod+Alt+Y                           hotkey-overlay-title="angelOS: лирика вкл/выкл" { spawn-sh "qs -c angelos ipc call angelos lyrics"; }
    Mod+Alt+T                           hotkey-overlay-title="angelOS: светлая/тёмная" { spawn-sh "qs -c angelos ipc call angelos theme toggle"; }
}
