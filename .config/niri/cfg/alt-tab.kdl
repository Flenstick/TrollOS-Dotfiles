// Alt+Tab (встроенный переключатель niri) — компактнее, чем по умолчанию.
// Цвета рамки задаёт angelOS (angelos.kdl), здесь только размеры и задержки.
// Внутри переключателя: ←/→ — выбор, Q — закрыть окно, Esc — отмена,
// A/W/O — все окна / этот рабочий стол / этот монитор, S — по кругу.
recent-windows {
    // окно, на котором задержались меньше этого, не попадает в начало списка
    // (по умолчанию 750 мс — после быстрого переключения порядок «запаздывал»)
    debounce-ms 300
    // быстрое Alt+Tab туда-обратно не показывает полосу вовсе
    open-delay-ms 120

    highlight {
        padding 10          // было 30: толстая рамка вокруг выбранного
        corner-radius 0     // окна в angelOS без скруглений
    }
    previews {
        max-height 230      // было 480: влезало всего три окна
        max-scale 0.25
    }
}
