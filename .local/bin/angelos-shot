#!/usr/bin/env python3
"""angelos-shot — снимок экрана в духе ShareX для niri + angelOS.

Экран замирает сразу: grim снимает весь экран (≈20 мс), и выделение и пометки
дальше идут по этому кадру, а не по живому экрану — видео, анимации и курсор
в кадр не попадают.

  Выделение   тянуть мышью — область; клик — окно под курсором (или весь монитор);
              Enter/Пробел — весь монитор; C — скопировать цвет пикселя;
              колёсико — увеличение лупы; Esc/ПКМ — отмена.
  Пометки     панель под областью: рамка, эллипс, стрелка, линия, карандаш, маркер,
              текст, номер шага, размытие, пикселизация; цвета, толщина, заливка.
              Клавиши по физическим кнопкам (работают и в русской раскладке):
              V R E A L P M T N B X, F — заливка, C — следующий цвет, 1–4 — толщина,
              колёсико — толщина, Ctrl+Z / Ctrl+Y, Del — убрать пометку, стрелки —
              сдвинуть область (Shift ×10, Ctrl — размер), ПКМ — выделить заново.
  Действия    Enter/Ctrl+C — готово (буфер + ~/Pictures/Screenshots), Ctrl+S — сохранить как,
              Ctrl+P — закрепить поверх окон, Ctrl+T — распознать текст, Ctrl+U — загрузить
              на catbox.moe и скопировать ссылку, Esc — отмена.

Вид выделения берётся из angelOS (Настройки → Скриншоты, capture.skin): window /
stream рисует capture_skins.py, остальное — свой чистый вид. Цвета панели — из
текущей темы (~/.cache/angelos/palette.json).

`angelos-shot --pin FILE [X Y]` — закреплённая картинка: тянуть мышью, колёсико —
масштаб, Ctrl+колёсико — прозрачность, Ctrl+C — копировать, Esc/двойной клик/СКМ — закрыть.
"""
from __future__ import annotations

import fcntl
import io
import json
import math
import os
import re
import signal
import subprocess
import sys
import time

ARGS = sys.argv[1:]
PIN = bool(ARGS) and ARGS[0] == "--pin"
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"


def single_instance():
    """One selection at a time — shared with niri-screenshot-region / record-region."""
    fd = os.open(os.path.join(RUNTIME, "niri-screenshot-region.lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    return fd


def _windows_snip():
    """Windows 11 layout (bar.style "windows", win.snip on): the Snipping Tool look."""
    try:
        with open(os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "angelos/settings.json")) as f:
            d = json.load(f)
        return (d.get("bar") or {}).get("style") == "windows" and (d.get("win") or {}).get("snip", False) is True
    except (OSError, ValueError):
        return False


if __name__ == "__main__" and not PIN and not os.environ.get("ANGELOS_SHOT_CLASSIC") and _windows_snip():
    _snip = os.path.join(os.path.dirname(os.path.realpath(__file__)), "angelos-snip")
    if os.path.isfile(_snip):
        os.execv(sys.executable, [sys.executable, _snip] + ARGS)

if not PIN:
    _LOCK = single_instance()
    if _LOCK is None:
        sys.exit(0)
    # freeze first: grim and niri answer while GTK is still loading
    _GRIM = subprocess.Popen(["grim", "-l", "0", "-"], stdout=subprocess.PIPE)
    _NIRI = {k: subprocess.Popen(["niri", "msg", "-j", k], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
             for k in ("windows", "workspaces", "outputs")}

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
