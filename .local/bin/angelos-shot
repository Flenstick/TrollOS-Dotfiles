WIDTHS = [2, 4, 7, 12]
TOOLS = [  # id, tooltip, evdev keycode + 8 (layout independent)
    ("move", "Двигать область и пометки", "V", 55),
    ("rect", "Рамка", "R", 27),
    ("ellipse", "Эллипс", "E", 26),
