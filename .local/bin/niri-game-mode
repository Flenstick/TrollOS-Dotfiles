#!/usr/bin/env python3
"""Disable niri animations and compositor effects while a window covers an output."""
from __future__ import annotations

import json
import os
import select
import subprocess
import sys
import time
from pathlib import Path

CFG = Path.home() / ".config/niri/cfg/game-mode.kdl"

ON = """\
// auto-generated by niri-game-mode — fullscreen: effects off (animations stay on)
window-rule {
    opacity 1.0
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry false
}

window-rule {
    background-effect {
        blur false
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-"
    background-effect {
        blur false
        xray false
    }
}
"""

OFF = """\
// auto-generated by niri-game-mode — inactive
"""

# A new state must hold this long before the config is reloaded, so a window
# passing through output size (launch, fullscreen toggle, alt-tab) costs one
# reload instead of a burst of them.
ON_DELAY = 0.3
OFF_DELAY = 0.15  # было 0.6: эффекты возвращались заметным рывком уже после перехода
SIZE_SLACK = 2


def niri_json(*args):
    raw = subprocess.check_output(["niri", "msg", "--json", *args], stderr=subprocess.DEVNULL)
    return json.loads(raw)


def output_sizes() -> dict[str, tuple[int, int]]:
    try:
        outputs = niri_json("outputs") or {}
    except (subprocess.CalledProcessError, json.JSONDecodeError, FileNotFoundError):
        return {}
    sizes = {}
    for name, o in outputs.items():
        logical = o.get("logical") or {}
        try:
            sizes[name] = (int(logical["width"]), int(logical["height"]))
        except (KeyError, TypeError, ValueError):
            continue
    return sizes


class State:
    """Windows and workspaces, kept current from niri's event stream."""

    def __init__(self) -> None:
        self.sizes = output_sizes()
        self.workspaces: dict[int, dict] | None = None
        self.windows: dict[int, dict] | None = None

    @property
    def ready(self) -> bool:
        return self.workspaces is not None and self.windows is not None

    def feed(self, line: bytes) -> None:
        try:
            ev = json.loads(line)
            if isinstance(ev, dict) and len(ev) == 1:
                (key, body), = ev.items()
                self.handle(key, body)
        except (json.JSONDecodeError, KeyError, TypeError, ValueError, AttributeError):
            pass

    def handle(self, key: str, body: dict) -> None:
        if key == "WorkspacesChanged":
            self.workspaces = {ws["id"]: ws for ws in body["workspaces"]}
            # A new output (hotplug) shows up here first.
            if any(ws.get("output") and ws["output"] not in self.sizes
                   for ws in self.workspaces.values()):
                self.sizes = output_sizes()
        elif key == "WorkspaceActivated" and self.workspaces is not None:
            ws = self.workspaces.get(body["id"])
            if ws is not None:
                for other in self.workspaces.values():
                    if other.get("output") == ws.get("output"):
                        other["is_active"] = False
                ws["is_active"] = True
        elif key == "WindowsChanged":
            self.windows = {w["id"]: w for w in body["windows"]}
        elif key == "WindowOpenedOrChanged" and self.windows is not None:
            self.windows[body["window"]["id"]] = body["window"]
        elif key == "WindowClosed" and self.windows is not None:
            self.windows.pop(body["id"], None)
        elif key == "WindowLayoutsChanged" and self.windows is not None:
            for wid, layout in body["changes"]:
                if wid in self.windows:
                    self.windows[wid]["layout"] = layout
        elif key == "ConfigLoaded":
            # Mode, scale or transform may have changed.
            self.sizes = output_sizes()

    def load_snapshot(self) -> None:
        self.handle("WorkspacesChanged", {"workspaces": niri_json("workspaces") or []})
        self.handle("WindowsChanged", {"windows": niri_json("windows") or []})

    def covering(self) -> tuple[dict, str | None] | None:
        """Return (window, output) for a window that covers its output, if any."""
        if not self.ready:
            return None
        active = {ws["id"]: ws.get("output")
                  for ws in self.workspaces.values() if ws.get("is_active")}
        for win in self.windows.values():
            wid = win.get("workspace_id")
            if wid not in active:
                continue
            size = (win.get("layout") or {}).get("window_size") or [0, 0]
            try:
                ww, hh = int(size[0]), int(size[1])
            except (TypeError, ValueError, IndexError):
                continue
            oname = active[wid]
            candidates = [self.sizes[oname]] if oname in self.sizes else list(self.sizes.values())
            for ow, oh in candidates:
                if abs(ww - ow) <= SIZE_SLACK and abs(hh - oh) <= SIZE_SLACK:
                    return win, oname
        return None


class Hysteresis:
    """Commit a new target only after it has held for its delay."""

    def __init__(self) -> None:
        self.applied: bool | None = None
        self.pending: bool | None = None
        self.deadline = 0.0

    def update(self, target: bool, now: float) -> bool | None:
        """Feed the current target; return a state to apply now, or None."""
        if self.applied is None:
            self.applied = target
            return target
        if target == self.applied:
            self.pending = None
        elif target != self.pending:
            self.pending = target
            self.deadline = now + (ON_DELAY if target else OFF_DELAY)
        return self.poll(now)

    def poll(self, now: float) -> bool | None:
        if self.pending is not None and now >= self.deadline:
            self.applied, self.pending = self.pending, None
            return self.applied
        return None

    def timeout(self, now: float) -> float | None:
        return None if self.pending is None else max(0.0, self.deadline - now)


def apply(on: bool, dry_run: bool = False) -> bool:
    """Write the config for `on` and reload niri; return False if already there."""
    text = ON if on else OFF
    try:
        if CFG.read_text() == text:
            return False
    except OSError:
        pass
    if dry_run:
        return True
    CFG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CFG.with_name("game-mode.kdl.tmp")
    tmp.write_text(text)
    tmp.replace(CFG)
    subprocess.call(["niri", "msg", "action", "load-config-file"], stderr=subprocess.DEVNULL)
    return True


def commit(on: bool, state: State, dry_run: bool) -> None:
    if not apply(on, dry_run):
        return
    msg = "game mode " + ("on" if on else "off")
    hit = state.covering() if on else None
    if hit:
        win, oname = hit
        w, h = win["layout"]["window_size"]
        msg += f": {win.get('app_id')} {w}x{h} on {oname}"
    if dry_run:
        msg += " (dry run)"
    print(msg, file=sys.stderr, flush=True)


def watch(dry_run: bool) -> None:
    hyst = Hysteresis()
    while True:
        proc = None
        try:
            proc = subprocess.Popen(
                ["niri", "msg", "--json", "event-stream"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                bufsize=0,
            )
            assert proc.stdout is not None
            fd = proc.stdout.fileno()
            state = State()
            buf = b""
            while True:
                ready, _, _ = select.select([fd], [], [], hyst.timeout(time.monotonic()))
                if ready:
                    chunk = os.read(fd, 1 << 16)
                    if not chunk:
                        break
                    buf += chunk
                    *lines, buf = buf.split(b"\n")
                    for line in lines:
                        if line.strip():
                            state.feed(line)
                    if not state.ready:
                        continue
                    result = hyst.update(state.covering() is not None, time.monotonic())
                else:
                    result = hyst.poll(time.monotonic())
                if result is not None:
                    commit(result, state, dry_run)
        except Exception as e:
            print(f"niri-game-mode: {e!r}", file=sys.stderr, flush=True)
        finally:
            if proc is not None:
                proc.kill()
                proc.wait()
        time.sleep(1.5)


def main() -> None:
    dry_run = "--dry-run" in sys.argv
    if "--watch" in sys.argv:
        watch(dry_run)
        return
    state = State()
    try:
        state.load_snapshot()
    except (subprocess.CalledProcessError, json.JSONDecodeError, FileNotFoundError):
        pass
    on = state.covering() is not None
    commit(on, state, dry_run)
    print("on" if on else "off")


if __name__ == "__main__":
    main()
